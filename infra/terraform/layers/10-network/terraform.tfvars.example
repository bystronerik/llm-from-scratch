# Copy to terraform.tfvars (gitignored) and fill in. Shared provider values
# (project, aws_region, aws_profile, extra_tags) live in ../../common.tfvars.
#
#   cp terraform.tfvars.example terraform.tfvars

# Your public IP. Default (203.0.113.0/32) is RFC 5737 documentation space: valid, and
# reachable by nobody. Find yours with: curl -s https://checkip.amazonaws.com
ssh_allowed_cidr = "203.0.113.0/32" # TODO: "<your.ip>/32"

# Optional overrides:
# vpc_cidr              = "10.42.0.0/16"
# trainer_instance_type = "g6e.xlarge"   # keep in sync with the iam + compute layers
